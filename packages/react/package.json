{
  "name": "mystique-mini-react",
  "version": "0.2.0",
  "description": "Mystique React design system",
  "type": "module",
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "license": "MIT",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/gabrielmnzs/mystique-mini.git",
    "directory": "packages/react"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./preset": {
      "import": {
        "types": "./dist/preset.d.ts",
        "default": "./dist/preset.js"
      },
      "require": {
        "types": "./dist/preset.d.cts",
        "default": "./dist/preset.cjs"
      }
    },
    "./styled-system": {
      "import": {
        "types": "./dist/styled-system.d.ts",
        "default": "./dist/styled-system.js"
      },
      "require": {
        "types": "./dist/styled-system.d.cts",
        "default": "./dist/styled-system.cjs"
      }
    },
    "./next": {
      "import": {
        "types": "./dist/next.d.ts",
        "default": "./dist/next.js"
      },
      "require": {
        "types": "./dist/next.d.cts",
        "default": "./dist/next.cjs"
      }
    },
    "./typegen": {
      "import": {
        "types": "./dist/typegen.d.ts",
        "default": "./dist/typegen.js"
      },
      "require": {
        "types": "./dist/typegen.d.cts",
        "default": "./dist/typegen.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "mystique-typegen": "./dist/typegen-cli.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "pnpm build:dist && pnpm smoke:cjs && pnpm smoke:esm && pnpm smoke:declarations && pnpm smoke:package",
    "build:dist": "tsup --config tsup.config.ts && tsup --config tsup.client.config.ts && tsup --config tsup.cli.config.ts",
    "smoke:cjs": "node fixtures/built-artifact.cjs",
    "smoke:esm": "node fixtures/built-artifact.mjs",
    "smoke:declarations": "tsc -p tsconfig.build-declarations.json && tsc -p tsconfig.build-declarations.cjs.json",
    "smoke:package": "node scripts/package-smoke.mjs",
    "dev": "tsup --config tsup.client.config.ts --watch",
    "test": "vitest run",
    "lint": "eslint src",
    "check-types": "tsc --noEmit"
  },
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "next": ">=15.0.0 <17.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/is-prop-valid": "^1.3.1"
  },
  "devDependencies": {
    "@emotion/jest": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^26.1.0",
    "next": "16.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
