{
  "name": "@gabrielmnzs/mystique-docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "docusaurus build --out-dir dist",
    "check-types": "tsc --noEmit --pretty false",
    "clear": "docusaurus clear",
    "dev": "docusaurus start",
    "lint": "eslint docusaurus.config.ts playwright.config.ts sidebars.ts scripts src tests",
    "serve": "docusaurus serve --dir dist",
    "serve:test": "node scripts/serve.mjs",
    "test": "pnpm test:content",
    "test:content": "node scripts/check-content.mjs",
    "test:smoke": "pnpm build && playwright test",
    "test:smoke:built": "playwright test"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@emotion/react": "^11.14.0",
    "@mdx-js/react": "^3.1.1",
    "clsx": "^2.1.1",
    "mystique-mini-react": "workspace:*",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/plugin-content-docs": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  }
}
